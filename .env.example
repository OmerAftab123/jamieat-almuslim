# Copy this file to `.env.local` for local development (never commit `.env.local`).
#
# The MVP needs NO secrets and NO database. All research data ships as versioned
# JSON files under data/. The variables below are optional and PUBLIC (they are
# embedded in the website), so never put a secret value in any NEXT_PUBLIC_ variable.

# Public canonical URL of the deployed site, used for metadata (sitemap/OG tags).
# Leave empty during local development.
NEXT_PUBLIC_SITE_URL=

# Reserved for a future PostgreSQL/Supabase migration (see docs/ARCHITECTURE.md).
# Not read by the current application. If you ever add them, they are SERVER-ONLY
# secrets: do not prefix them with NEXT_PUBLIC_ and do not import them in client components.
# DATABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
